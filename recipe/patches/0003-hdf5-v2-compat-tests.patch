From bcf10508e336f529be7e036b0dc31dc6273dc034 Mon Sep 17 00:00:00 2001
From: Mervin Fansler <mervin.fansler@bric.ku.dk>
Date: Wed, 15 Jul 2026 15:58:35 +0200
Subject: [PATCH] hdf5 v2 compat tests

---
 tests/testthat/test-h5p.R         | 4 ++--
 tests/testthat/test-zzz-DataSet.R | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/tests/testthat/test-h5p.R b/tests/testthat/test-h5p.R
index 1fe19e2..4edc640 100755
--- a/tests/testthat/test-h5p.R
+++ b/tests/testthat/test-h5p.R
@@ -118,8 +118,8 @@ test_that("H5P_DATASET_CREATE works", {
 test_that("H5P_DATASET_ACCESS works", {
     h5p_obj <- H5P_DATASET_ACCESS$new()
     h5p_obj$set_chunk_cache(rdcc_nslots=-1, rdcc_nbytes=-1, rdcc_w0=-1)
-    expect_equal(h5p_obj$get_chunk_cache()$rdcc_nslots, 521)
-    expect_equal(h5p_obj$get_chunk_cache()$rdcc_nbytes, 1048576)
+    expect_equal(h5p_obj$get_chunk_cache()$rdcc_nslots, 8191)
+    expect_equal(h5p_obj$get_chunk_cache()$rdcc_nbytes, 8388608)
     expect_equal(h5p_obj$get_chunk_cache()$rdcc_w0, 0.75)
 })
 
diff --git a/tests/testthat/test-zzz-DataSet.R b/tests/testthat/test-zzz-DataSet.R
index fc4704f..fc3c58d 100644
--- a/tests/testthat/test-zzz-DataSet.R
+++ b/tests/testthat/test-zzz-DataSet.R
@@ -138,7 +138,7 @@ test_that("DataSet-list-dataset",{
 
   ex <- c("testgroup/testgroup1/testset1", "testgroup/testgroup2/testset2",
           "testgroup/testset", "testgroup3/testgroup3/testset3")
-  expect_that(list.datasets(file), is_identical_to(ex))
+  expect_setequal(list.datasets(file), ex)
 
   #ex <- c("testset1", "testset2", "testset", "testset3")
   #expect_that(list.datasets(file), is_identical_to(ex))
@@ -146,7 +146,7 @@ test_that("DataSet-list-dataset",{
   ex <- c("testgroup1/testset1", "testgroup2/testset2",
           "testset")
   testgroup <- file[["testgroup"]]
-  expect_that(list.datasets(testgroup), is_identical_to(ex))
+  expect_setequal(list.datasets(testgroup), ex)
   h5close(testgroup)
   h5close(file)
   expect_true(file.remove(fname))
